@startuml IDP_Platform_EmployeeService_L3_v6_boundary
!ENABLE_ALL_PLANT_ELEMENTS = 1
!include <C4/C4_Component>

title IDP Platform — Employee Service — диаграмма компонентов (L3)

LAYOUT_TOP_DOWN()

System_Ext(hris, "HRIS / Кадровая система", "Предоставляет данные сотрудников, подразделений, должностей и подчинённости.")

System_Boundary(idpPlatform, "IDP Platform") {

    Container(gateway, "API Gateway", "Go", "Маршрутизирует запросы, проверяет локальные или корпоративные токены и ограничивает частоту запросов.")
    ContainerDb(employeeDb, "Employee DB", "PostgreSQL", "Хранит сотрудников, оргструктуру, назначения прикладных ролей, данные локального входа, состояние синхронизации и outbox.")
    ContainerQueue(eventStreams, "Брокер событий", "Apache Kafka", "Передаёт кадровые события и события для отправки служебных писем.")
    ContainerDb(objectStorage, "Object Storage", "MinIO", "Хранит аватары сотрудников.")

    Container_Boundary(employeeService, "Employee Service") {

        together {
            Component(employeeApi, "Employee API Controller", "Go / HTTP Handler", "Принимает запросы по сотрудникам, оргструктуре, прикладным ролям и локальным учётным записям. Предоставляет API Gateway открытые ключи проверки локальных токенов.")
            Component(hrisWorker, "HRIS Polling Worker", "Go Background Worker", "По расписанию запускает цикл импорта данных из HRIS.")
            Component(outboxWorker, "Outbox Publishing Worker", "Go Background Worker", "По расписанию запускает цикл публикации событий outbox.")
        }

        together {
            Component(employeeAppService, "Employee Management Service", "Go Application Service", "Читает и изменяет данные сотрудников, управляет аватарами.")
            Component(organizationAppService, "Organization Structure Service", "Go Application Service", "Ведёт подразделения, должности и связи подчинённости.")
            Component(roleAppService, "Role Management Service", "Go Application Service", "Читает и изменяет назначения прикладных ролей и области их действия.")
            Component(localAuth, "Local Authentication", "Go package", "Активирует локальные учётные записи, проверяет пароли и выдаёт токены. Обрабатывает смену пароля после проверки личности и подтверждение новых контактов.")
            Component(hrisImportService, "HRIS Import Service", "Go Application Service", "Получает кадровые изменения из HRIS и передаёт данные сотрудников и оргструктуры соответствующим компонентам.")
            Component(outboxPublishService, "Outbox Publication Service", "Go Application Service", "Получает неопубликованные события outbox, публикует их и фиксирует результат.")
        }

        together {
            Component(employeeRepo, "Employee Repository", "Go / pgx", "Читает и сохраняет данные сотрудников.")
            Component(organizationRepo, "Organization Repository", "Go / pgx", "Читает и сохраняет подразделения, должности и связи подчинённости.")
            Component(roleRepo, "Role Repository", "Go / pgx", "Читает и сохраняет назначения прикладных ролей и области их действия.")
            Component(localAuthRepo, "Local Account Repository", "Go / pgx", "Хранит привязки учётных записей к сотрудникам, хеши паролей, подтверждённые контакты и состояние одноразовых запросов активации и подтверждения.")
            Component(syncStateRepo, "Sync State Repository", "Go / pgx", "Хранит контрольную точку и состояние импорта HRIS.")
            Component(outboxRepo, "Outbox Repository", "Go / pgx", "Сохраняет события outbox, выдаёт неопубликованные записи и отмечает опубликованные.")
            Component(hrisClient, "HRIS Client", "Go / HTTP Client", "Выполняет REST-запросы к HRIS и преобразует полученные кадровые данные.")
            Component(kafkaProducer, "Kafka Producer", "Go / Kafka Client", "Публикует кадровые события и события для служебных писем в Apache Kafka.")
            Component(avatarStorage, "Avatar Storage Adapter", "Go / S3 Client", "Сохраняет, получает и удаляет аватары в MinIO.")
        }
    }
}

' Входящие запросы
Rel(gateway, employeeApi, "Передаёт запросы по сотрудникам, оргструктуре, ролям и локальному входу. Получает открытые ключи проверки локальных токенов", "HTTPS / REST / JSON / JWKS")

Rel(employeeApi, employeeAppService, "Передаёт запросы по сотрудникам", "Go Call")
Rel(employeeApi, organizationAppService, "Передаёт запросы по оргструктуре", "Go Call")
Rel(employeeApi, roleAppService, "Передаёт запросы по прикладным ролям", "Go Call")
Rel(employeeApi, localAuth, "Передаёт запросы по активации, входу, смене пароля и подтверждению контактов. Получает открытые ключи", "Go Call")

' Фоновые процессы
Rel(hrisWorker, hrisImportService, "Запускает цикл импорта", "Go Call")
Rel(outboxWorker, outboxPublishService, "Запускает цикл публикации", "Go Call")

' Импорт кадровых данных
Rel(hrisImportService, syncStateRepo, "Читает и обновляет контрольную точку импорта", "Go Call")
Rel(hrisImportService, hrisClient, "Получает кадровые изменения", "Go Call")
Rel(hrisImportService, employeeAppService, "Передаёт изменения данных сотрудников", "Go Call")
Rel(hrisImportService, organizationAppService, "Передаёт изменения подразделений, должностей и подчинённости", "Go Call")

' Работа с данными и событиями
Rel(employeeAppService, employeeRepo, "Читает и сохраняет сотрудников", "Go Call")
Rel(employeeAppService, outboxRepo, "Записывает кадровые события", "Go Call")
Rel(employeeAppService, avatarStorage, "Работает с аватарами", "Go Call")

Rel(organizationAppService, organizationRepo, "Читает и сохраняет оргструктуру", "Go Call")
Rel(organizationAppService, outboxRepo, "Записывает события оргструктуры", "Go Call")

Rel(roleAppService, roleRepo, "Читает и сохраняет назначения прикладных ролей", "Go Call")
Rel(roleAppService, outboxRepo, "Записывает события об изменении назначений ролей", "Go Call")

Rel(localAuth, employeeRepo, "Проверяет связь учётной записи с сотрудником", "Go Call")
Rel(localAuth, localAuthRepo, "Читает и сохраняет данные локального входа", "Go Call")
Rel(localAuth, outboxRepo, "Записывает события для писем активации и подтверждения контактов", "Go Call")

Rel(outboxPublishService, outboxRepo, "Читает неопубликованные события и фиксирует результат", "Go Call")
Rel(outboxPublishService, kafkaProducer, "Передаёт события на публикацию", "Go Call")

' Внешние связи
Rel(hrisClient, hris, "Получает данные сотрудников, подразделений, должностей и подчинённости", "HTTPS / REST / JSON")
Rel(avatarStorage, objectStorage, "Работает с файлами аватаров", "S3 API / HTTPS")
Rel(kafkaProducer, eventStreams, "Публикует кадровые события и события для служебных писем", "Kafka protocol / TLS")

Rel(employeeRepo, employeeDb, "Читает и сохраняет сотрудников", "PostgreSQL / TLS")
Rel(organizationRepo, employeeDb, "Читает и сохраняет оргструктуру", "PostgreSQL / TLS")
Rel(roleRepo, employeeDb, "Читает и сохраняет назначения ролей", "PostgreSQL / TLS")
Rel(localAuthRepo, employeeDb, "Читает и сохраняет данные локального входа", "PostgreSQL / TLS")
Rel(syncStateRepo, employeeDb, "Читает и сохраняет состояние импорта", "PostgreSQL / TLS")
Rel(outboxRepo, employeeDb, "Читает и изменяет outbox", "PostgreSQL / TLS")

SHOW_LEGEND()

@enduml