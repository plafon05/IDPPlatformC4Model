@startuml IDP_Platform_L2
!ENABLE_ALL_PLANT_ELEMENTS = 1
!include <C4/C4_Container>

title IDP Platform — диаграмма контейнеров

LAYOUT_TOP_DOWN()

skinparam ranksep 150
skinparam nodesep 40

' Пользователи
together {
    Person(employee, "Сотрудник", "Работает с ИПР, задачами, компетенциями и карьерными целями.")
    Person(manager, "Руководитель", "Согласовывает ИПР, оценивает сотрудников и развитие команды.")
    Person(hrAdmin, "HR-администратор", "Управляет справочниками, карьерными моделями и кадровым резервом.")
}


' Внешние системы
System_Ext(lms, "LMS / Обучающая платформа", "Предоставляет курсы, прогресс и результаты обучения.")
System_Ext(iam, "Корпоративный IAM / SSO", "Обеспечивает единый вход и выдаёт токены доступа.")
System_Ext(hris, "HRIS / Кадровая система", "Предоставляет сведения о сотрудниках и оргструктуре.")
System_Ext(smtp, "Корпоративный SMTP-сервис", "Обеспечивает доставку email.")


' Контейнеры платформы
System_Boundary(idpPlatform, "IDP Platform — платформа развития сотрудников") {

    Container(web, "Web Application", "React, TypeScript","Интерфейс ИПР, компетенций, карьеры, обучения, адаптации, аналитики и уведомлений.",$baseShape="frame")
    Container(gateway, "API Gateway", "Go","Маршрутизирует запросы, проверяет токены, ограничивает частоту запросов и проксирует SSE.",$baseShape="hexagon")
    ContainerQueue(eventStreams, "Брокер событий", "Apache Kafka","Хранит и передаёт события между сервисами.")
    Container(employeeService, "Employee Service", "Go","Управляет сотрудниками, оргструктурой, ролями и синхронизацией с HRIS.")
    ContainerDb(employeeDb, "Employee DB", "PostgreSQL","Хранит сотрудников, оргструктуру, роли, данные синхронизации и outbox.")
    Container(developmentService, "Development Plan Service", "Go","Управляет ИПР, задачами, оценками, комментариями, адаптацией и напоминаниями.")
    ContainerDb(developmentDb, "Development Plan DB", "PostgreSQL","Хранит планы, задачи, оценки, шаблоны, напоминания, проекции и outbox.")
    Container(analyticsService, "Analytics & Reporting Service", "Go, Excelize, go-pdf/fpdf","Рассчитывает показатели и формирует аналитические отчёты XLSX/PDF.")
    ContainerDb(analyticsDb, "Analytics DB", "PostgreSQL","Хранит аналитические проекции, права доступа и данные отчётности.")
    Container(talentService, "Talent Service", "Go","Управляет компетенциями, карьерой, обучением и резервом. Формирует Talent Profile, Skill Gap и рекомендации.")
    ContainerDb(objectStorage, "Object Storage", "MinIO","Хранит аватары, вложения и отчёты.")
    ContainerDb(talentDb, "Talent DB", "PostgreSQL","Хранит компетенции, карьерные модели, обучение, резерв, проекции и outbox.")
    Container(notificationService, "Notification Service", "Go","Доставляет email и in-app уведомления, управляет их историей и повторными попытками.")
    ContainerDb(notificationDb, "Notification DB", "PostgreSQL","Хранит уведомления, настройки, статусы прочтения и доставки.")
}


' Пользовательский интерфейс
Rel(employee, web, "Работает со своим развитием", "HTTPS")
Rel(manager, web, "Управляет развитием команды", "HTTPS")
Rel(hrAdmin, web, "Администрирует платформу", "HTTPS")


' Аутентификация и входная точка
Rel(web, gateway, "Вызывает API и получает уведомления", "HTTPS / REST / SSE")
Rel(web, iam, "Входит в систему и получает токены", "OIDC / PKCE / HTTPS")
Rel(gateway, iam, "Получает ключи проверки токенов", "OIDC Discovery / JWKS / HTTPS")


' Маршрутизация запросов
Rel(gateway, employeeService, "Запросы сотрудников и оргструктуры", "HTTPS / REST / JSON")
Rel(gateway, developmentService, "Запросы ИПР и адаптации", "HTTPS / REST / JSON")
Rel(gateway, analyticsService, "Запросы аналитики и отчётов", "HTTPS / REST / JSON")
Rel(gateway, talentService, "Запросы компетенций и карьеры", "HTTPS / REST / JSON")
Rel(gateway, notificationService, "Запросы уведомлений и SSE", "HTTPS / REST / SSE")


' Связи сервисов с БД, брокером, хранилищем и внешними системами
Rel(employeeService, employeeDb, "Читает и изменяет кадровые данные и outbox", "PostgreSQL / TLS")
Rel(employeeService, hris, "Синхронизирует сотрудников и оргструктуру", "HTTPS / REST / JSON")
Rel(employeeService, eventStreams, "Публикует кадровые события", "Kafka protocol / TLS")
Rel(employeeService, objectStorage, "Работает с аватарами", "S3 API / HTTPS")

Rel(developmentService, objectStorage, "Работает с вложениями", "S3 API / HTTPS")
Rel(developmentService, eventStreams, "Публикует и читает события развития", "Kafka protocol / TLS")
Rel(developmentService, developmentDb, "Читает и изменяет планы, проекции и outbox", "PostgreSQL / TLS")

Rel(analyticsService, analyticsDb, "Читает и сохраняет аналитику", "PostgreSQL / TLS")
Rel(analyticsService, objectStorage, "Работает с отчётами", "S3 API / HTTPS")
Rel(analyticsService, eventStreams, "Читает события для аналитики", "Kafka protocol / TLS")

Rel(talentService, talentDb, "Читает и изменяет данные развития и outbox", "PostgreSQL / TLS")
Rel(talentService, eventStreams, "Публикует и читает события развития", "Kafka protocol / TLS")
Rel(talentService, lms, "Получает курсы и результаты обучения", "HTTPS / REST / JSON")

Rel(notificationService, eventStreams, "Читает события для уведомлений", "Kafka protocol / TLS")
Rel(notificationService, notificationDb, "Хранит уведомления и статусы доставки", "PostgreSQL / TLS")
Rel(notificationService, smtp, "Отправляет email", "SMTP / TLS")


SHOW_LEGEND()

@enduml