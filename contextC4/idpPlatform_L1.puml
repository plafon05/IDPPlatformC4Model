@startuml IDP_Platform_L1
!include <C4/C4_Context>

title IDP Platform - System Context Diagram

LAYOUT_LEFT_RIGHT()

Person(employee, "Сотрудник", "Управляет своим развитием: работает с ИПР, компетенциями, карьерными целями, обучением и профилем развития.")

Person(manager, "Руководитель", "Управляет развитием сотрудников, сопровождает ИПР, оценивает прогресс и готовность к карьерному росту.")

Person(hrAdmin, "HR-администратор", "Управляет пользователями, оргструктурой, компетенциями, карьерными моделями, адаптацией, кадровым резервом и аналитикой.")

System(idpPlatform, "IDP Platform", "Корпоративная платформа управления развитием и кадровым потенциалом сотрудников: ИПР, компетенции, карьерные траектории, обучение, адаптация и кадровый резерв.")

System_Ext(iam, "Корпоративный IAM / SSO", "Обеспечивает корпоративную идентификацию пользователей и единый вход.")

System_Ext(hris, "HRIS / Кадровая система", "Источник данных о сотрудниках, подразделениях, должностях и организационной структуре.")

System_Ext(lms, "LMS / Обучающая платформа", "Предоставляет каталог обучения, сведения о прохождении курсов и результаты обучения сотрудников.")

System_Ext(smtp, "Корпоративный SMTP-сервис", "Корпоративная почтовая инфраструктура для доставки email-уведомлений.")


Rel(employee, idpPlatform, "Управляет своим развитием", "HTTPS")

Rel(manager, idpPlatform, "Управляет развитием сотрудников", "HTTPS")

Rel(hrAdmin, idpPlatform, "Администрирует платформу и аналитику", "HTTPS")


Rel(idpPlatform, iam, "Аутентифицирует пользователей", "OIDC / HTTPS")

Rel(idpPlatform, hris, "Запрашивает кадровые данные", "REST / JSON / HTTPS")

Rel(hris, idpPlatform, "Передаёт кадровые данные", "REST / JSON / HTTPS")

Rel(idpPlatform, lms, "Запрашивает данные об обучении", "REST / JSON / HTTPS")

Rel(lms, idpPlatform, "Передаёт результаты обучения", "REST / JSON / HTTPS")

Rel(idpPlatform, smtp, "Передаёт email-уведомления", "SMTP / TLS")

SHOW_LEGEND()

@enduml