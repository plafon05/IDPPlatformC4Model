@startuml IDP_Platform_Dynamic_Process

!include <C4/C4_Container>

title IDP Platform — общая динамическая диаграмма: назначение ИПР с курсом LMS, проверка результата и обновление Skill Gap

LAYOUT_TOP_DOWN()

skinparam shadowing false
skinparam nodesep 65
skinparam ranksep 100

Person(manager, "Руководитель", "Выбирает сотрудника, настраивает и назначает ИПР, подтверждает выполнение заданий.")
Person(employee, "Сотрудник", "Выполняет задания ИПР, проходит курс LMS и получает уведомления.")

System_Boundary(idpPlatform, "IDP Platform") {
    Container(gateway, "API Gateway", "Go", "Проверяет токены, маршрутизирует REST-запросы и проксирует SSE.")
    Container(employeeService, "Employee Service", "Go", "Проверяет доступ к команде и возвращает сотрудников, должности и связи подчинённости.")
    Container(talentService, "Talent Service", "Go", "Предоставляет профиль развития, Skill Gap и рекомендации; получает результаты LMS и обновляет уровни компетенций по правилам ИПР.")
    Container(developmentService, "Development Plan Service", "Go", "Создаёт и назначает ИПР, хранит результаты заданий и правила обновления уровней, пересчитывает прогресс и фиксирует контрольные точки.")
    Container(notificationService, "Notification Service", "Go", "Сохраняет уведомления и доставляет их через SSE и корпоративный SMTP.")
    ContainerQueue(kafka, "Брокер событий", "Apache Kafka", "Передаёт события назначения ИПР, результатов обучения, контрольных точек и изменения уровней компетенций.")
}

System_Ext(lms, "Корпоративная LMS", "Предоставляет курсы и результаты их прохождения.")
System_Ext(smtp, "Корпоративный SMTP-сервис", "Принимает письма для доставки пользователям.")

' Запросы руководителя

Rel(manager, gateway, "1. Запрашивает доступных подчинённых\n5. Запрашивает профиль, Skill Gap и рекомендации\n9. Создаёт ИПР из выбранного ПР, добавляет курс LMS, задаёт условия контрольной точки и правило обновления уровня, назначает план\n29. Запрашивает результат задания\n33. Подтверждает выполнение задания", "HTTPS / REST / JSON")

Rel(gateway, manager, "4. Возвращает список сотрудников\n8. Возвращает профиль, дефициты и рекомендации\n12. Подтверждает назначение ИПР\n28. Доставляет уведомление о необходимости проверки\n32. Возвращает результат задания\n36. Возвращает прогресс и состояние контрольной точки\n42. Уведомляет о достижении контрольной точки", "HTTPS / REST / JSON\nУведомления — HTTPS / SSE")

' Получение сотрудников

Rel(gateway, employeeService, "2. Передаёт запрос подчинённых и проверенный контекст пользователя", "HTTPS / REST / JSON")

Rel(employeeService, gateway, "3. Проверяет право просмотра команды и возвращает доступных сотрудников и должности; при отказе — 403 Forbidden, сценарий прекращается", "HTTPS / JSON")

' Профиль развития и Skill Gap

Rel(gateway, talentService, "6. Запрашивает профиль, Skill Gap и рекомендации сотрудника\n48. Запрашивает обновлённый профиль самого сотрудника", "HTTPS / REST / JSON")

Rel(talentService, gateway, "7. Возвращает профиль, дефициты и рекомендации, включая курсы LMS\n49. Рассчитывает Skill Gap по новым окончательным уровням и возвращает обновлённый профиль", "HTTPS / JSON")

' Подготовка ИПР, выполнение и проверка

Rel(gateway, developmentService, "10. Передаёт команды создания, настройки и назначения ИПР, включая правило обновления уровня\n19. Запрашивает назначенный сотруднику ИПР\n30. Запрашивает результат задания для проверки\n34. Передаёт подтверждение выполнения задания", "HTTPS / REST / JSON")

Rel(developmentService, gateway, "11. Проверяет права, создаёт копию ПР, сохраняет настройки, правило и назначение ИПР\n20. Возвращает ИПР, задания и ссылку на курс\n31. Возвращает критерий и сохранённый результат курса\n35. Подтверждает задание, пересчитывает прогресс, фиксирует достижение точки и записывает CheckpointReached в outbox", "HTTPS / JSON")

' Действия сотрудника

Rel(employee, gateway, "18. Открывает назначенный ИПР\n47. Запрашивает обновлённый профиль развития", "HTTPS / REST / JSON")

Rel(gateway, employee, "16. Уведомляет о назначении ИПР\n21. Возвращает ИПР и ссылку на курс\n41. Уведомляет о достижении контрольной точки\n45. Уведомляет об обновлении уровня по правилу ИПР\n50. Возвращает обновлённый профиль и Skill Gap", "HTTPS / REST / JSON\nУведомления — HTTPS / SSE")

Rel(employee, lms, "22. Открывает курс и проходит обучение; LMS сохраняет результат", "HTTPS")

' Интеграция с LMS

Rel(talentService, lms, "23. При очередной синхронизации запрашивает результаты обучения", "HTTPS / REST / JSON")

Rel(lms, talentService, "24. Возвращает результат курса; Talent сопоставляет сотрудника и курс, сохраняет результат и событие в outbox", "HTTPS / JSON")

' События Development Plan Service

Rel(developmentService, kafka, "13. Публикует событие назначения ИПР\n26. После получения результата LMS фиксирует ожидание проверки и публикует соответствующее событие\n37. Публикует CheckpointReached с данными настроенного правила", "Kafka protocol / TLS; публикация через outbox")

Rel(kafka, developmentService, "25б. Передаёт результат обучения для соответствующего задания ИПР", "Kafka protocol / TLS")

' События Talent Service

Rel(talentService, kafka, "25а. Публикует событие получения результата курса\n43. Публикует событие автоматического изменения окончательного уровня", "Kafka protocol / TLS; публикация через outbox")

Rel(kafka, talentService, "38. Передаёт CheckpointReached; Talent обновляет сведения о ходе ИПР, применяет правило, сохраняет окончательный уровень, основание и событие в outbox", "Kafka protocol / TLS")

' Создание и доставка уведомлений

Rel(kafka, notificationService, "14. Передаёт событие назначения ИПР\n27а. Передаёт событие ожидания проверки\n39. Передаёт событие достижения контрольной точки\n44а. Передаёт событие автоматического изменения окончательного уровня", "Kafka protocol / TLS")

Rel(notificationService, gateway, "15. Передаёт уведомление о назначении ИПР сотруднику\n27б. Передаёт уведомление о проверке руководителю\n40. Передаёт уведомления о контрольной точке обоим участникам\n44б. Передаёт уведомление об обновлении уровня сотруднику", "HTTPS / SSE; по ранее открытым соединениям")

Rel(notificationService, smtp, "17. Передаёт email о назначении ИПР\n27в. Передаёт email о необходимости проверки\n40а. Передаёт email о достижении контрольной точки\n46. Передаёт email об обновлении уровня; для каждого события — если email предусмотрен настройками", "SMTP / TLS")

' Условия сценария

note left of employeeService : Перед получением списка Employee Service проверяет доступ к команде указанного руководителя. Остальные сервисы также проверяют права на свои операции и конкретные записи.

note right of developmentService : ИПР создаётся из выбранной версии ПР. Для задания с курсом LMS заданы срок, положительный вес, критерий и обязательная проверка руководителем. Правило контрольной точки задаёт компетенцию и её новый окончательный уровень. На шаге 35 условия точки выполнены. Контрольная точка не добавляет веса к прогрессу. 100% прогресса не завершает ИПР автоматически.

note right of talentService : Каталог курсов получен ранее через адаптер LMS. Само прохождение курса уровень не меняет. Talent обновляет уровень после получения CheckpointReached с заранее заданным правилом. Повторная доставка того же события не создаёт новую оценку. Skill Gap рассчитывается по действующим окончательным уровням и требованиям профиля.

note right of notificationService : SSE-подключения сотрудника и руководителя через Gateway уже установлены. Перед доставкой сохраняются уведомление и задания доставки. Email и in-app доставляются независимо. Без активного SSE уведомление остаётся в истории.

legend bottom
Номера обозначают порядок взаимодействий в показанном сценарии; буквенные суффиксы уточняют действия одного этапа. Повторные взаимодействия объединены на одной стрелке. Внутренние компоненты и БД сервисов не раскрываются.
endlegend

@enduml