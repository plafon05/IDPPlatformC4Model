@startuml Development_Plan_Service_Dynamic_LMS

!include <C4/C4_Component>

title Development Plan Service — проверка задания с курсом LMS и достижение контрольной точки

LAYOUT_LEFT_RIGHT()

skinparam nodesep 50
skinparam ranksep 60

Person(manager, "Руководитель", "Проверяет результат курса и подтверждает выполнение задания ИПР.")
Container(gateway, "API Gateway", "Go", "Проверяет JWT и передаёт контекст пользователя.")
Container(talent, "Talent Service", "Go", "Получает результаты из LMS и применяет правила обновления компетенций.")
ContainerQueue(kafka, "Брокер событий", "Apache Kafka", "Передаёт результаты обучения и события ИПР.")
Container(notification, "Notification Service", "Go", "Уведомляет о задании на проверке и достижении контрольной точки.")

Container_Boundary(developmentService, "Development Plan Service") {
    Component(controller, "Development API Controller", "Go / HTTP Handler", "Принимает запросы на просмотр результата и подтверждение задания.")
    Component(consumer, "Kafka Event Consumer", "Go / Kafka Client", "Принимает результаты обучения от Talent Service.")
    Component(planService, "Development Plan Service", "Go Application Service", "Проверяет критерии заданий и права руководителя, пересчитывает прогресс, проверяет контрольные точки.")
    Component(planRepo, "Plan Repository", "Go / pgx", "Сохраняет изменения плана и события outbox в одной транзакции.")
    Component(outboxWorker, "Outbox Publishing Worker", "Go Background Worker", "Периодически запускает публикацию событий.")
    Component(outboxService, "Outbox Publication Service", "Go Application Service", "Публикует ожидающие события и фиксирует подтверждение Kafka.")
    Component(outboxRepo, "Outbox Repository", "Go / pgx", "Читает и отмечает опубликованные события.")
    Component(producer, "Kafka Producer", "Go / Kafka Client", "Публикует события ИПР.")
}

ContainerDb(developmentDb, "Development Plan DB", "PostgreSQL 16", "ИПР, задания, результаты, контрольные точки, правила изменения уровня и outbox.")

' Получение результата LMS
Rel(talent, kafka, "1. Публикует LearningResultRecorded", "Kafka / TLS, порт 9092")
Rel(kafka, consumer, "2. Передаёт LearningResultRecorded", "Kafka / TLS, порт 9092")
Rel(consumer, planService, "3. Передаёт результат обучения для обработки", "Go In-Process Call")
Rel(planService, planRepo, "4. Находит задание по сотруднику и курсу, проверяет критерий; сохраняет результат, on_review и событие TaskStatusChanged", "Go In-Process Call")
Rel(planRepo, developmentDb, "5. Сохраняет результат, статус и запись outbox в одной транзакции", "PostgreSQL / TLS, порт 5432")

' Фоновая публикация; тот же путь используется после подтверждения
Rel(outboxWorker, outboxService, "6. Запускает публикацию TaskStatusChanged\n17. Запускает публикацию CheckpointReached", "Go In-Process Call")
Rel(outboxService, outboxRepo, "7, 18. Читает ожидающее событие; после подтверждения Kafka отмечает отправленным", "Go In-Process Call")
Rel(outboxRepo, developmentDb, "7, 18. Читает и обновляет outbox", "PostgreSQL / TLS, порт 5432")
Rel(outboxService, producer, "8, 19. Передаёт событие на публикацию", "Go In-Process Call")
Rel(producer, kafka, "9. Публикует TaskStatusChanged (on_review)\n20. Публикует CheckpointReached с данными правила", "Kafka / TLS, порт 9092")
Rel(kafka, notification, "10. Передаёт событие о задании на проверке\n22. Передаёт событие достижения контрольной точки", "Kafka / TLS, порт 9092")

' Проверка руководителем и достижение контрольной точки
Rel(manager, gateway, "11. Запрашивает сохранённый результат курса\n14. Подтверждает выполнение задания", "HTTPS / REST / JSON")
Rel(gateway, controller, "11, 14. Передаёт запрос и контекст руководителя", "HTTPS / REST / JSON, порт 8080")
Rel(controller, planService, "12. Запрашивает результат после проверки доступа\n15. Передаёт подтверждение после проверки доступа", "Go In-Process Call")
Rel(planService, planRepo, "12. Читает результат и критерий задания\n15. Отмечает задание выполненным, пересчитывает прогресс и проверяет условия контрольной точки", "Go In-Process Call")
Rel(planRepo, developmentDb, "12. Читает результат и критерий\n16. Сохраняет решение и прогресс; если условия точки выполнены, фиксирует достижение и CheckpointReached в outbox", "PostgreSQL / TLS, порт 5432")
Rel(controller, gateway, "13. Возвращает результат и критерий\n16а. Возвращает обновлённый прогресс и состояние контрольной точки", "HTTPS / JSON")
Rel(gateway, manager, "13. Показывает результат для проверки\n16а. Показывает результат подтверждения", "HTTPS / JSON")

Rel(kafka, talent, "21. Передаёт CheckpointReached: сотрудник, контрольная точка и настроенное правило обновления уровня", "Kafka / TLS, порт 9092")

note bottom of planService
    Результат LMS соответствует критерию задания,
    но его выполнение должен подтвердить руководитель.
    До подтверждения прогресс не увеличивается.
    Показан случай, когда после подтверждения выполнены условия точки.
end note

note bottom of talent
    Руководитель заранее задал компетенцию и её новый окончательный уровень.
    Talent применяет правило после получения CheckpointReached.
    Development Plan Service уровень компетенции не записывает.
end note

note bottom of producer
    Повторная доставка событий не должна повторно
    менять статус задания или применять правило.
    Номера, повторённые на нескольких связях,
    обозначают части одного шага.
end note

SHOW_LEGEND()

@enduml
